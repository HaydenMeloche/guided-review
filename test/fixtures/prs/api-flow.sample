 });
+
+describe('refundOrder', () => {
+  it('refunds a recent order', async () => {
+    expect(await refundOrder('o-1', 'damaged')).toMatchObject({ orderId: 'o-1', reason: 'damaged' });
+  });
+
+  it('refuses an order past the refund window', async () => {
+    await expect(refundOrder('o-old', 'late')).rejects.toThrow('refund window closed');
+  });
+});
