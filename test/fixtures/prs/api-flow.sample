--- a/src/services/orders.ts
+++ b/src/services/orders.ts
@@ -1,5 +1,7 @@
-import { findOrders, findOrder } from '../db/ordersRepo.js';
-import type { Order } from '../types.js';
+import { findOrders, findOrder, saveRefund } from '../db/ordersRepo.js';
+import type { Order, Refund } from '../types.js';
+
+export const REFUND_WINDOW_DAYS = 30;
 
 export async function listOrders(): Promise<Order[]> {
   return findOrders();
@@ -10,3 +12,11 @@ export async function getOrder(id: string): Promise<Order> {
   if (!order) throw new Error(`order ${id} not found`);
   return order;
 }
+
+export async function refundOrder(id: string, reason: string): Promise<Refund> {
+  const order = await getOrder(id);
+  const age = (Date.now() - order.placedAt.getTime()) / 86_400_000;
+  if (age > REFUND_WINDOW_DAYS) throw new Error('refund window closed');
+  if (order.status === 'refunded') throw new Error('already refunded');
+  return saveRefund({ orderId: id, amountCents: order.totalCents, reason });
+}
