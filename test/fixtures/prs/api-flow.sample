 }
+
+export async function saveRefund(refund: Omit<Refund, 'id'>): Promise<Refund> {
+  const row = await db.insert('refunds', refund);
+  await db.update('orders', { id: refund.orderId }, { status: 'refunded' });
+  return row;
+}
