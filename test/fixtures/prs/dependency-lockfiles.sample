lockfileVersion: '9.0'

importers:

  apps/admin:
    dependencies:
      react:
        specifier: ^18.3.1
        version: 18.3.1

  apps/web:
    dependencies:
      react:
        specifier: ^18.3.1
        version: 18.3.1

packages:

  csstype@3.1.2:
    resolution: {integrity: sha512-aaa}

  js-tokens@4.0.0:
    resolution: {integrity: sha512-bbb}

  loose-envify@1.4.0:
    resolution: {integrity: sha512-ccc}
    hasBin: true

  react@18.3.1:
    resolution: {integrity: sha512-ddd}
    engines: {node: '>=0.10.0'}

snapshots:

  csstype@3.1.2: {}

  js-tokens@4.0.0: {}

  loose-envify@1.4.0:
    dependencies:
      js-tokens: 4.0.0

  react@18.3.1:
    dependencies:
      loose-envify: 1.4.0
